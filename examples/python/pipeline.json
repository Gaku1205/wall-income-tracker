{
  "tools": { "python": "3.12" },
  "setup": [ "pip install -r requirements-dev.txt" ],
  "checks": [
    { "name": "リント", "run": "ruff check ." },
    { "name": "型チェック", "run": "mypy" },
    { "name": "テスト", "run": "pytest -q" }
  ],
  "deploy": [
    { "kind": "aws-apprunner", "service": "hello-python", "port": 8000, "health": "/health" },
    { "kind": "github-release", "os": ["windows-latest", "macos-latest"], "build": "pyinstaller --onefile --name hello cli.py", "files": "dist/*" }
  ]
}
